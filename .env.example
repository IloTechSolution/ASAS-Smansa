# Salin menjadi `.env` di root untuk pengembangan lokal.
# Nilai di bawah ini HANYA untuk dev — ganti di production.

# PostgreSQL (sesuai docker-compose.yml)
DATABASE_URL=postgresql://cbt:cbt_dev_secret@localhost:5432/cbt?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# JWT (minimal 32 karakter di production!)
JWT_SECRET=dev-only-change-me-to-min-32-random-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Token ujian rotating (default per sesi, bisa dioverride Proktor)
TOKEN_DEFAULT_INTERVAL_SEC=120

# Throttle login: maks. percobaan gagal per IP+username dalam jendela waktu.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SEC=300

# Browser Exam Key SEB (64 hex). Kosongkan untuk dev tanpa sesi wajib SEB;
# WAJIB diisi di production bila ada sesi requireSeb=true.
# Beberapa versi/platform SEB boleh dipisah koma.
SEB_BROWSER_EXAM_KEY=

# Upload gambar soal
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5

# Alamat CBT yang tercetak di QR Kartu Login (produksi: domain publik)
WEB_URL=http://localhost:8080

# Kunci khusus enkripsi at-rest kolom User.initialPassword (kartu login).
# Default: diturunkan dari JWT_SECRET. Set terpisah bila JWT_SECRET dirotasi
# agar password tersimpan tetap bisa dibaca.
#   openssl rand -hex 32
# INITIAL_PASSWORD_SECRET=

# Kunci khusus hash PIN keluar SEB (HMAC-SHA256). Default: diturunkan dari JWT_SECRET.
#   openssl rand -hex 32
# PIN_HASH_SECRET=

# Slug sekolah default untuk konteks publik (logo/branding tanpa ?school=).
# DEFAULT_SCHOOL_SLUG=sman1

