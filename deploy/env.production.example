# ============================================================================
# Contoh konfigurasi PRODUKSI — salin menjadi /opt/cbt/.env.production
#
#   cp deploy/env.production.example .env.production
#   chmod 600 .env.production
#
# JANGAN commit .env.production. File ini hanya contoh.
# ============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=cbt
POSTGRES_DB=cbt
# WAJIB diganti. Pakai hex agar aman di URL DATABASE_URL:
#   openssl rand -hex 24
POSTGRES_PASSWORD=GANTI_DENGAN_openssl_rand_hex_24

# --- API / keamanan ---------------------------------------------------------
# WAJIB diganti, minimal 32 karakter acak:
#   openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_openssl_rand_hex_32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Alamat yang dipakai browser. Samakan dengan URL publik/LAN.
# Contoh LAN: http://192.168.1.50
# Contoh domain + HTTPS: https://cbt.sekolah.sch.id
CORS_ORIGIN=http://192.168.1.50

# Browser Exam Key dari konfigurasi SEB (.seb). Kosongkan bila belum memakai SEB.
# Bisa lebih dari satu, pisahkan koma.
SEB_BROWSER_EXAM_KEY=

# --- Akun admin awal --------------------------------------------------------
# Produksi tidak membuat akun demo. Admin pertama dibuat dari nilai di bawah
# saat database masih kosong. Ganti password lewat UI setelah login.
#   openssl rand -base64 24
SEED_DEMO=false
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_KUAT

# --- Aturan ujian & login ---------------------------------------------------
TOKEN_DEFAULT_INTERVAL_SEC=120
UPLOAD_MAX_MB=5
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SEC=300
# Kunci enkripsi at-rest `initialPassword` (default: diturunkan dari JWT_SECRET).
# Sebaiknya set terpisah agar rotasi JWT_SECRET tidak merusak data tersimpan.
#   openssl rand -hex 32
# INITIAL_PASSWORD_SECRET=
# Kunci hash PIN keluar SEB (default: diturunkan dari JWT_SECRET).
#   openssl rand -hex 32
# PIN_HASH_SECRET=
# Slug sekolah default (branding publik tanpa ?school=).
# DEFAULT_SCHOOL_SLUG=sman1

# --- Publikasi web ----------------------------------------------------------
# LAN langsung: 0.0.0.0:80  -> http://IP-VM
# Di belakang Caddy/Nginx host: 127.0.0.1:8080 (lihat docs/DEPLOYMENT.md)
WEB_BIND=0.0.0.0
WEB_PORT=80

# Zona waktu untuk tanggal di ekspor PDF/Excel. Gorontalo = WITA.
TZ=Asia/Makassar

WEB_URL=https://cbt.sekolah.sch.id

