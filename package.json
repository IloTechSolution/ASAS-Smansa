{
  "name": "cbt-sman1-gorontalo",
  "version": "0.1.0",
  "private": true,
  "description": "CBT SMAN 1 Gorontalo — ujian online (NestJS API + React Web + SEB Android kiosk)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @cbt/api",
    "dev:web": "npm run dev -w @cbt/web",
    "build": "npm run build -w @cbt/shared && npm run build -w @cbt/api && npm run build -w @cbt/web",
    "build:shared": "npm run build -w @cbt/shared",
    "build:api": "npm run build -w @cbt/api",
    "build:web": "npm run build -w @cbt/web",
    "lint": "npm run lint -w @cbt/web",
    "seed": "npm run seed -w @cbt/api",
    "e2e": "npm run e2e -w @cbt/web",
    "load:test": "node scripts/load-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@nestjs/common": "11.2.10",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/websockets": "11.2.10"
  }
}
